{
  "name": "gbsim-poc",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "sundai.willsarg.com", "custom_domain": true }],
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "html_handling": "none", "run_worker_first": ["/docs.html"] },
  "durable_objects": {
    "bindings": [{ "name": "INSTANCE", "class_name": "Instance" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Instance"] }]
}
